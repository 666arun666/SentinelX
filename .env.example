# Database Configuration
DATABASE_URL=postgresql+psycopg://sentinelx:password@localhost:5432/sentinelx

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Qdrant Configuration
QDRANT_URL=http://localhost:6333

# --- SECRETS (Replace with real values in your local .env) ---
# AI / LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Threat Intelligence Configuration
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OPENCTI_URL=your_opencti_url_here
OPENCTI_API_KEY=your_opencti_api_key_here

# --- FOUNDATIONS (Non-secret configurations) ---
RISK_SCORE_WEIGHTS={"criticality": 0.4, "severity": 0.6}
RISK_AI_ADJUSTMENT_BOUND=20
CORRELATION_WINDOW_SECONDS=3600
BACKPRESSURE_QUEUE_SIZE=1000

LLM_MODEL_TIER_1=claude-3-haiku-20240307
LLM_MODEL_TIER_2=claude-3-sonnet-20240229
LLM_MODEL_TIER_3=claude-3-opus-20240229

LLM_MAX_CALLS_PER_CASE=10
LLM_MAX_COST_PER_CASE=0.50
LLM_MAX_COST_PER_DAY=5.0

RETENTION_PERIOD_DAYS=30
DISK_SPACE_WARNING_THRESHOLD=0.85
