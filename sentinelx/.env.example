# Copy this file to .env and fill in the values you have.
# SentinelX degrades gracefully when optional integrations are left unset.

# --- Core -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data
REPORTS_DIR=./data/reports
DEMO_MODE=false

# --- Database (required) ---------------------------------------------------
DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@localhost:5432/sentinelx

# --- Redis (required) --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Qdrant / RAG (required for MITRE mapping + memory) ----------------------
QDRANT_URL=http://localhost:6333

# --- LLM (optional — required for AI reasoning stages) ------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_REASONING=claude-sonnet-4-6
LLM_MODEL_FAST=claude-haiku-4-5

# --- Observability (optional) -----------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinelx
LANGSMITH_TRACING=false

# --- Threat intelligence (optional — falls back to mock providers) -----------
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OPENCTI_URL=
OPENCTI_API_KEY=

# --- Log sources (Linux host monitoring) --------------------------------------
MONITOR_AUTH_LOG=/var/log/auth.log
MONITOR_SYSLOG=/var/log/syslog
MONITOR_USE_JOURNALCTL=true
MONITOR_USE_AUDITD=false
MONITOR_HOSTNAME=
